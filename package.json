{
	"name": "personal-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"homepage": "https://Teinble.github.io/",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@types/react": "^19.1.4",
		"@types/react-dom": "^19.1.4",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router-dom": "^7.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/node": "^20.19.13",
		"@vitejs/plugin-react": "^5.0.2",
		"gh-pages": "^6.1.1",
		"jsdom": "^25.0.1",
		"lint-staged": "^16.1.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.2",
		"vite": "^7.1.5",
		"vitest": "^2.1.9"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest --run",
		"test:watch": "vitest",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"predeploy": "vite build",
		"deploy": "gh-pages -d dist",
		"prepare": "husky"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"lint-staged": {
		"*.{js, jsx, ts, tsx}": [
			"npm run lint:fix"
		]
	}
}
