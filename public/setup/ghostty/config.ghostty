# Ghostty — a dark, Powerline-compatible terminal profile.
theme = Night Owl
font-family = Meslo LG L for Powerline
font-size = 14
window-padding-x = 12
window-padding-y = 10
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
keybind = alt+backspace=text:\x17
